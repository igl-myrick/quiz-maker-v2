# Copy to supabase/functions/.env for local development (that file is gitignored).
# On the hosted project, the owner sets these with `supabase secrets set`.
# Secret names must not start with SUPABASE_.

# Key for the salted hash of anonymous visitors' IPs. Any long random string.
IP_HASH_SECRET=replace-with-a-long-random-string

# Local only: there is no Cloudflare locally, so trust x-forwarded-for for the client IP.
# Never set this on a hosted project.
RATE_LIMIT_TRUST_XFF=true
