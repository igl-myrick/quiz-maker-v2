# Local Google and GitHub OAuth apps for `supabase start` (change 9).
# Copy to supabase/.env (gitignored) and fill in. Plain KEY=value lines: no quotes, no export.
# Each app's callback URL is http://127.0.0.1:54321/auth/v1/callback.
# Restart the stack after editing: npm run db:stop, then npm run db:start.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
